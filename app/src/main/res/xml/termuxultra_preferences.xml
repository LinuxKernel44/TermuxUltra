<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:key="tab_bar"
        app:title="@string/termuxultra_tab_bar_header">

        <ListPreference
            app:defaultValue="4000"
            app:entries="@array/tab_bar_hide_delay_entries"
            app:entryValues="@array/tab_bar_hide_delay_values"
            app:key="tab_bar_hide_delay"
            app:title="@string/termuxultra_tab_bar_hide_delay_title"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory
        app:key="wake_lock"
        app:title="@string/termuxultra_wake_lock_header">

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="wake_lock_on_start"
            app:summary="@string/termuxultra_wake_lock_on_start_summary"
            app:title="@string/termuxultra_wake_lock_on_start_title" />

    </PreferenceCategory>

</PreferenceScreen>
