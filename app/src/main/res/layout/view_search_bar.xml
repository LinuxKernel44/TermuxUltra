<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/search_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/tab_bar_background"
    android:orientation="vertical"
    android:paddingBottom="6dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#88FFFFFF"
            android:textCursorDrawable="@null"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/search_counter"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/search_previous"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_previous"
            android:src="@drawable/ic_arrow_up" />

        <ImageButton
            android:id="@+id/search_next"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_next"
            android:src="@drawable/ic_arrow_down" />

        <ImageButton
            android:id="@+id/search_close"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_close"
            android:src="@drawable/ic_tab_close" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/search_toggle_case"
                style="@style/TermuxUltraSearchToggle"
                android:text="@string/search_toggle_case" />

            <TextView
                android:id="@+id/search_toggle_regex"
                style="@style/TermuxUltraSearchToggle"
                android:text="@string/search_toggle_regex" />

            <TextView
                android:id="@+id/search_toggle_all_tabs"
                style="@style/TermuxUltraSearchToggle"
                android:text="@string/search_toggle_all_tabs" />

            <TextView
                android:id="@+id/search_toggle_history"
                style="@style/TermuxUltraSearchToggle"
                android:text="@string/search_toggle_history" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
